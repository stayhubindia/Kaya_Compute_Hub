[Unit]
Description=Kaya Compute Hub Worker Service (Single Concurrency, SQLite Source of Truth)
After=network.target kaya-redis.service

[Service]
Type=simple
User=durgesh
WorkingDirectory=/home/Project/Kaya_Compute_Hub
EnvironmentFile=-/home/Project/Kaya_Compute_Hub/.env
EnvironmentFile=-/home/Project/Kaya_Compute_Hub/services/api/.env
Environment="PATH=/home/Project/Kaya_Compute_Hub/.venv/bin:/usr/bin"
Environment="PYTHONPATH=/home/Project/Kaya_Compute_Hub:/home/Project/Kaya_Compute_Hub/services/api"
ExecStart=/home/Project/Kaya_Compute_Hub/.venv/bin/celery -A services.worker.celery_app worker -l info -c 1 --prefetch-multiplier=1
Restart=always
RestartSec=5s

# Low-resource systemd limits (2GB RAM VM protection)
MemoryMax=512M
CPUQuota=100%
TasksMax=50

[Install]
WantedBy=multi-user.target
