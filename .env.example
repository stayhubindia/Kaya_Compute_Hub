# Kaya Compute Hub Environment Configuration Example
# Copy to .env and supply actual runtime configuration values. NEVER commit real secrets.

# Django API Configuration
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-environment-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TOTP_ENCRYPTION_KEY=super-secret-fernet-key-for-totp-encryption-32bytes=

# PostgreSQL Database Configuration
DATABASE_URL=postgres://kaya_user:kaya_password@localhost:5432/kaya_db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage Directories
STORAGE_BASE_DIR=./storage

# Direct Google Drive/Colab CLI credentials are imported from each account's
# ~/.config/colab-cli/token.json through the dashboard and encrypted server-side.
GOOGLE_TOKEN_ENCRYPTION_KEY=fernet-encryption-key-for-google-tokens-32bytes=
FRONTEND_URL=http://localhost:3000
COLAB_CLI_BIN=colab

# Milestone 10: Colab Enterprise & Google Cloud Configuration
GOOGLE_ALLOWED_PROJECTS=my-gcp-project-1,my-gcp-project-2
GOOGLE_ALLOWED_REGIONS=us-central1,us-east4,europe-west1
COLAB_ENTERPRISE_ENABLED=False
COLAB_ENTERPRISE_DEFAULT_OUTPUT_BUCKET=gs://my-colab-outputs-bucket
COLAB_ENTERPRISE_SERVICE_ACCOUNT_EMAIL=colab-connector@my-gcp-project.iam.gserviceaccount.com
