# Kaya Compute Hub - Django REST API Environment Configuration Example

# Security & Django Secret Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-50-character-secret-key-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Database Configuration (Defaults to SQLite in development if omitted)
DATABASE_URL=postgres://kaya_user:kaya_password@localhost:5432/kaya_db

# Redis & Celery Message Broker Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cookie & Session Security Settings
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SESSION_COOKIE_SAMESITE=Lax
DJANGO_CSRF_COOKIE_SAMESITE=Lax

# CORS & CSRF Trusted Origins Configuration
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Throttling Limits
LOGIN_RATE_LIMIT=10/minute

# Storage & Dataset Factory Configuration
DATA_ROOT=/srv/kaya-data
GOOGLE_DRIVE_ROOT=My Drive/Colab Notebooks/Datasets/CyberSecurity/

# Downloader & Dataset Manager Configuration
DOWNLOAD_ALLOWED_DOMAINS=
DOWNLOAD_BLOCKED_DOMAINS=
DOWNLOAD_MAX_FILE_SIZE_BYTES=10737418240
DOWNLOAD_MAX_EXTRACTED_SIZE_BYTES=5368709120
DOWNLOAD_MAX_ARCHIVE_FILES=10000
DOWNLOAD_MAX_REDIRECTS=5
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=10
DOWNLOAD_READ_TIMEOUT_SECONDS=30
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_MAX_CONCURRENT_PER_USER=5
DOWNLOAD_DAILY_QUOTA_BYTES=53687091200
DOWNLOAD_STORAGE_ROOT=/srv/kaya-data/storage/datasets
DOWNLOAD_TEMP_ROOT=/srv/kaya-data/storage/temp/downloads
